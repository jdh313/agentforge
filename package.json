{
  "name": "agentforge",
  "version": "0.1.0",
  "description": "Render canonical AI agent artifacts for multiple harnesses (Claude Code, OpenCode, Codex)",
  "license": "Apache-2.0",
  "author": "Jacob Hoehler <accts@jdh.onl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdh313/agentforge.git"
  },
  "homepage": "https://github.com/jdh313/agentforge#readme",
  "bugs": {
    "url": "https://github.com/jdh313/agentforge/issues"
  },
  "type": "module",
  "private": true,
  "bin": {
    "agentforge": "./src/cli.ts"
  },
  "exports": {
    "./agent-command": "./src/agent-command.ts",
    "./check": "./src/check.ts",
    "./compiler": "./src/compiler.ts",
    "./definitions": "./src/definitions.ts",
    "./materializer": "./src/materializer.ts",
    "./marketplace-adapters": "./src/marketplace-adapters.ts",
    "./render": "./src/render.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "bun build --compile src/cli.ts --outfile dist/agentforge",
    "install:bin": "bun run build && ln -sf \"$PWD/dist/agentforge\" ~/.local/bin/agentforge"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "^1.3.13",
    "typescript": "^7.0.2"
  }
}
